<?xml version="1.0" encoding="UTF-8"?>
<interface domain="owly-drop">
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="OwlyDropWindow" parent="AdwApplicationWindow">
    <property name="title">Owly Drop</property>
    <property name="default-width">540</property>
    <property name="default-height">760</property>
    <property name="width-request">360</property>
    <property name="height-request">294</property>
    <property name="content">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <child type="end">
              <object class="GtkMenuButton">
                <property name="primary">True</property>
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text" translatable="yes">Main Menu</property>
                <property name="menu-model">primary_menu</property>
              </object>
            </child>
          </object>
        </child>
        <child type="top">
          <object class="AdwBanner" id="banner">
            <property name="title" translatable="yes">Wi-Fi is off while this computer is visible. Turn visibility off to get it back.</property>
          </object>
        </child>
        <property name="content">
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="child">
              <object class="AdwPreferencesPage">
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Receive</property>
                    <child>
                      <object class="AdwSwitchRow" id="visible_row">
                        <property name="title" translatable="yes">Visible to iPhones</property>
                        <signal name="notify::active" handler="on_visible_changed"/>
                      </object>
                    </child>
                    <child>
                      <object class="AdwSwitchRow" id="auto_accept_row">
                        <property name="title" translatable="yes">Accept Automatically</property>
                        <property name="subtitle" translatable="yes">No confirmation dialog</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="send_group">
                    <property name="title" translatable="yes">Send</property>
                    <property name="description" translatable="yes">Or drop files onto the window.</property>
                    <child>
                      <object class="AdwButtonRow">
                        <property name="title" translatable="yes">_Send Files…</property>
                        <property name="use-underline">True</property>
                        <property name="start-icon-name">document-send-symbolic</property>
                        <property name="action-name">win.send-files</property>
                        <property name="tooltip-text">Ctrl+O</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup" id="received_group">
                    <property name="title" translatable="yes">Received</property>
                    <child>
                      <object class="AdwActionRow" id="placeholder_row">
                        <property name="title" translatable="yes">Nothing received yet</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <property name="title" translatable="yes">Settings</property>
                    <child>
                      <object class="AdwEntryRow" id="name_row">
                        <property name="title" translatable="yes">Name Shown on iPhones</property>
                        <property name="show-apply-button">True</property>
                        <signal name="apply" handler="on_name_applied"/>
                      </object>
                    </child>
                    <child>
                      <object class="AdwActionRow" id="folder_row">
                        <property name="title" translatable="yes">Download Folder</property>
                        <child type="suffix">
                          <object class="GtkButton">
                            <property name="label" translatable="yes">_Change…</property>
                            <property name="use-underline">True</property>
                            <property name="valign">center</property>
                            <signal name="clicked" handler="on_choose_folder"/>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="AdwPreferencesGroup">
                    <child>
                      <object class="GtkExpander">
                        <property name="label" translatable="yes">Technical Log</property>
                        <property name="child">
                          <object class="GtkScrolledWindow">
                            <property name="min-content-height">180</property>
                            <property name="margin-top">6</property>
                            <style>
                              <class name="card"/>
                            </style>
                            <property name="child">
                              <object class="GtkTextView" id="log_view">
                                <property name="editable">False</property>
                                <property name="monospace">True</property>
                                <property name="wrap-mode">word-char</property>
                                <property name="left-margin">6</property>
                                <property name="right-margin">6</property>
                                <property name="top-margin">6</property>
                                <property name="bottom-margin">6</property>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_About Owly Drop</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Quit</attribute>
        <attribute name="action">app.quit</attribute>
      </item>
    </section>
  </menu>
</interface>
