#!/usr/bin/env bash
# A fake owly for Owly Drop's self-test: prints what owly 0.4.2 prints.
cmd="$1 $2"
case "$1" in
  radio)
    trap 'echo "giving the radio back..." >&2; exit 0' TERM INT
    echo "bringing the radio up..." >&2
    sleep 0.3
    echo "awdl0 is up: fe80::1%awdl0 (02:00:00:00:00:01). Ctrl-C takes it down." >&2
    echo "receivers on it announce 3 times 250 ms apart, every 30 s (MDNS-7)" >&2
    sleep 0.2
    echo "peers: 26:6e:2e:62:df:eb (iPhone)" >&2
    while :; do sleep 0.1; done
    ;;
  receive)
    trap 'exit 0' INT
    dir=.
    while [ $# -gt 0 ]; do [ "$1" = --dir ] && dir="$2"; shift; done
    echo "receiving as \"Test PC\" (a1b2c3d4e5f6) on [fe80::1]:8771, flags 0x89" >&2
    sleep 0.3
    echo "seen by fe80::abcd" >&2
    echo "\"Alice's iPhone\" (\"iPhone\") wants to send:" >&2
    echo "  \"IMG_0001.HEIC\" public.heic 2345678 bytes" >&2
    printf 'accept? [y/N] ' >&2
    read -r -t 15 ans
    if [ "$ans" = y ]; then
      f="$dir/IMG_0001.HEIC"; printf 'fake' > "$f"; echo "$f"
    fi
    while :; do sleep 0.1; done
    ;;
  browse)
    sleep 0.3
    echo "a1b2c3d4e5f6   \"Alice's iPhone\" ([fe80::abcd%awdl0]:8770)"
    sleep 0.2
    ;;
  send)
    echo "looking for \"Alice's iPhone\" for 30 s..." >&2
    sleep 0.2
    echo "sending to \"Alice's iPhone\" at [fe80::abcd]:8770" >&2
    echo "accepted" >&2
    printf '\r100 / 200 bytes' >&2; sleep 0.1
    printf '\r200 / 200 bytes' >&2; echo >&2
    echo "delivered"
    ;;
  *) echo "fake owly: $cmd" >&2; exit 2 ;;
esac
